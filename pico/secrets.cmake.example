# Copy to pico/secrets.cmake (ignored by git) and fill in. Used only with -DWITH_GPT=ON.
set(OPENAI_API_KEY "sk-..." CACHE STRING "" FORCE)

# WiFi networks, tried in this order (after a scan: the ones in range first, see pico/README.md),
# as ssid / password pairs. Names and passwords may hold spaces; a semicolon must be written \;
set(WIFI_NETWORKS
    "home-network"  "its-password"
    "grandparents"  "their-password"
    CACHE STRING "" FORCE)

# The older single-network form still works and comes first in the list if set
# set(WIFI_SSID "my-network" CACHE STRING "" FORCE)
# set(WIFI_PASSWORD "my-password" CACHE STRING "" FORCE)
